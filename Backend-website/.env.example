# Database Configuration (Use your Supabase credentials)
DATABASE_HOST=aws-1-ap-south-1.pooler.supabase.com
DATABASE_NAME=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_PORT=5432
DATABASE_URL=postgresql://username:password@host:port/database
DATABASE_USERNAME=postgres.your_project_ref

# Email Configuration (choose one)
# Option A: Resend (recommended for reliability on Railway)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=UJGSM <noreply@your-domain.com>

# Option B: SMTP
SMTP_FROM=your_email@domain.com
SMTP_HOST=smtp.your-provider.com
SMTP_PASSWORD=your_smtp_password
SMTP_PORT=587
SMTP_USER=your_email@domain.com
# Optional SMTP tweaks
# SMTP_SECURE=false
# SMTP_CONNECTION_TIMEOUT=10000
# SMTP_GREETING_TIMEOUT=10000
# SMTP_SOCKET_TIMEOUT=10000
# EMAIL_MAX_WAIT_MS=8000

# Supabase Configuration
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_URL=https://your-project.supabase.co

# Production Environment
NODE_ENV=production
PORT=3000

# Frontend CORS (comma-separated list of allowed origins)
# Example: https://uora.com,https://www.uora.com
FRONTEND_ORIGINS=